+def test_named_wrapper_close_does_not_close_borrowed_buffer():
+    """Closing the wrapper flushes and detaches, it must not close the
+    borrowed buffer.
+    """
+    buffer = io.BytesIO()
+    wrapper = _NamedTextIOWrapper(buffer, name="<stdout>", mode="w")
+
+    wrapper.write("hello")
+    wrapper.close()
+
+    assert not buffer.closed
+    assert buffer.getvalue() == b"hello"
+
+
+def test_named_wrapper_close_is_idempotent():
+    """Closing the wrapper more than once does not raise."""
+    buffer = io.BytesIO()
+    wrapper = _NamedTextIOWrapper(buffer, name="<stdout>", mode="w")
+
+    wrapper.write("hello")
+    wrapper.close()
+    wrapper.close()
+
+    assert not buffer.closed
+    assert buffer.getvalue() == b"hello"
+
+
+def test_named_wrapper_gc_does_not_close_borrowed_buffer():
+    """The garbage collector must not close the borrowed buffer, even if the
+    wrapper was never explicitly closed. Pending text is flushed first, so no
+    output is lost.
+    """
+    buffer = io.BytesIO()
+    wrapper = _NamedTextIOWrapper(buffer, name="<stdout>", mode="w")
+
+    wrapper.write("hello")
+    del wrapper
+    gc.collect()
+
+    assert not buffer.closed
+    assert buffer.getvalue() == b"hello"
+
+
+def test_runner_does_not_close_real_stdout():
+    """Running a command then collecting garbage leaves the real stdout
+    usable.
+    """
+    real_stdout = sys.stdout
+    runner = CliRunner()
+
+    @click.command()
+    def cli():
+        # Grab a reference to the runner's stdout wrapper so it outlives
+        # the invocation and gets collected afterwards.
+        cli.leaked_stdout = sys.stdout
+        click.echo("captured")
+
+    result = runner.invoke(cli)
+    assert result.exit_code == 0
+    assert result.stdout == "captured\n"
+
+    del cli.leaked_stdout
+    gc.collect()
+
+    # The real stream is untouched and still writable.
+    assert sys.stdout is real_stdout
+    assert not real_stdout.closed
+
+
