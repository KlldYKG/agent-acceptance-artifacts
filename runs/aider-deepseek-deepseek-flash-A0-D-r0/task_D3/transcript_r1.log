import importlib.metadata

import click
from click.decorators import _find_distribution_name


def test_find_distribution_name_maps_module_to_distribution(monkeypatch):
    monkeypatch.setattr(
        importlib.metadata,
        "packages_distributions",
        lambda: {"my_module": ["my-distribution"]},
    )
    assert _find_distribution_name("my_module") == "my-distribution"


def test_find_distribution_name_uses_first_of_multiple(monkeypatch):
    monkeypatch.setattr(
        importlib.metadata,
        "packages_distributions",
        lambda: {"my_module": ["first-dist", "second-dist"]},
    )
    assert _find_distribution_name("my_module") == "first-dist"


def test_find_distribution_name_falls_back_to_module_name(monkeypatch):
    monkeypatch.setattr(importlib.metadata, "packages_distributions", lambda: {})
    assert _find_distribution_name("unknown_module") == "unknown_module"


def test_version_option_resolves_distribution_from_module(monkeypatch, runner):
    seen = {}

    def fake_version(name):
        seen["name"] = name
        return "1.2.3"

    monkeypatch.setattr(importlib.metadata, "version", fake_version)
    monkeypatch.setattr(
        importlib.metadata,
        "packages_distributions",
        lambda: {"my_module": ["my-distribution"]},
    )

    namespace = {"__name__": "my_module"}
    exec(
        "import click\n"
        "\n"
        "@click.command()\n"
        "@click.version_option(prog_name='mycli')\n"
        "def cli():\n"
        "    pass\n",
        namespace,
    )

    result = runner.invoke(namespace["cli"], ["--version"])
    assert result.exit_code == 0, result.output
    assert "mycli, version 1.2.3" in result.output
    assert seen["name"] == "my-distribution"


def test_version_option_falls_back_to_module_name(monkeypatch, runner):
    seen = {}

    def fake_version(name):
        seen["name"] = name
        return "4.5.6"

    monkeypatch.setattr(importlib.metadata, "version", fake_version)
    monkeypatch.setattr(importlib.metadata, "packages_distributions", lambda: {})

    namespace = {"__name__": "lonely_module"}
    exec(
        "import click\n"
        "\n"
        "@click.command()\n"
        "@click.version_option(prog_name='mycli')\n"
        "def cli():\n"
        "    pass\n",
        namespace,
    )

    result = runner.invoke(namespace["cli"], ["--version"])
    assert result.exit_code == 0, result.output
    assert "mycli, version 4.5.6" in result.output
    assert seen["name"] == "lonely_module"


def test_version_option_explicit_package_name_not_resolved(monkeypatch, runner):
    seen = {}

    def fake_version(name):
        seen["name"] = name
        return "9.9.9"

    def fail_packages_distributions():
        raise AssertionError("packages_distributions should not be called")

    monkeypatch.setattr(importlib.metadata, "version", fake_version)
    monkeypatch.setattr(
        importlib.metadata, "packages_distributions", fail_packages_distributions
    )

    @click.command()
    @click.version_option(package_name="explicit-dist", prog_name="mycli")
    def cli():
        pass

    result = runner.invoke(cli, ["--version"])
    assert result.exit_code == 0, result.output
    assert "mycli, version 9.9.9" in result.output
    assert seen["name"] == "explicit-dist"
