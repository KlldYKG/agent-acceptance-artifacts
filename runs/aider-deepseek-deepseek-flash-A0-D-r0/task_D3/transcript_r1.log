```python
def _resolve_distribution_name(module_name: str) -> str:
    """Resolve an imported top-level module name to the name of the
    distribution that provides it.

    Distribution names do not always match the top-level module they
    install (for example the ``pytest-cov`` distribution installs the
    ``pytest_cov`` module). :func:`importlib.metadata.version` expects a
    distribution name, so map the module name through
    :func:`importlib.metadata.packages_distributions` when possible.
    Falls back to the module name if no distribution can be found.
    """
    import importlib.metadata

    try:
        packages = importlib.metadata.packages_distributions()
    except Exception:  # pragma: no cover - defensive
        return module_name

    dists = packages.get(module_name)
    if dists:
        return dists[0]
    return module_name
```

