    assert "my\\ndir" in exc_info.value.message


def test_choice_get_invalid_choice_message():
    choice = click.Choice(["a", "b", "c"])
    message = choice.get_invalid_choice_message("d", ctx=None)
    assert message == "'d' is not one of 'a', 'b', 'c'."


def test_choice_get_metavar_arguments_not_pre_bracketed():
    """Arguments let ``Argument.make_metavar`` add the brackets, so the type
    must not wrap the choices itself for optional arguments.

    Wrapping them in both places produced a double-bracketed synopsis like
    ``[[a|b]]``. Options still get their brackets from the type.
    """
    ctx = click.Context(click.Command("cli"))
    choice = click.Choice(["a", "b"])

    required = click.Argument(["x"], type=choice, required=True)
    assert choice.get_metavar(required, ctx) == "{a|b}"

    optional = click.Argument(["x"], type=choice, required=False)
    assert choice.get_metavar(optional, ctx) == "a|b"

    option = click.Option(["--x"], type=choice)
    assert choice.get_metavar(option, ctx) == "[a|b]"
