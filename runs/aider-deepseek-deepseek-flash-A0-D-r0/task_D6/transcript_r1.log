```python
        if self._help_option is None:
            # Avoid circular import.
            from .decorators import help_option

            # Apply help_option decorator and pop resulting option
            help_option(*help_option_names)(self)
            opt: Option = self.params.pop()  # type: ignore[assignment]

            # The parameter name doubles as the parser destination, so it must
            # not clash with a parameter declared on the command. Otherwise the
            # eager help option would read the value parsed for that parameter,
            # e.g. for ``@click.argument("help")`` or
            # ``@click.option("--name", "help")``.
            used_names = {param.name for param in self.params if param.name}
            unique_name = opt.name

            while unique_name in used_names:
                unique_name = f"{unique_name}_"

            opt.name = unique_name
            self._help_option = opt
```

