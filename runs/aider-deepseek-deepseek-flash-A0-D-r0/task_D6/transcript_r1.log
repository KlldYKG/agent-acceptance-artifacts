```python
def test_argument_named_help(runner):
    """An argument named ``help`` must not be consumed by the help option."""

    @click.command()
    @click.argument("help")
    def cli(help):
        click.echo(f"help={help}")

    result = runner.invoke(cli, ["value"])
    assert result.exit_code == 0, result.output
    assert result.output == "help=value\n"


def test_argument_named_help_keeps_help_flag(runner):
    """The automatic ``--help`` option still works when an argument is named
    ``help``."""

    @click.command()
    @click.argument("help")
    def cli(help):
        click.echo(f"help={help}")

    result = runner.invoke(cli, ["--help"])
    assert result.exit_code == 0, result.output
    assert "Usage: cli [OPTIONS] HELP" in result.output


def test_option_named_help(runner):
    """An option named ``help`` must not be consumed by the help option."""

    @click.command()
    @click.option("--name", "help")
    def cli(help):
        click.echo(f"help={help}")

    result = runner.invoke(cli, ["--name", "value"])
    assert result.exit_code == 0, result.output
    assert result.output == "help=value\n"

    result = runner.invoke(cli, ["--help"])
    assert result.exit_code == 0, result.output
    assert "Usage: cli [OPTIONS]" in result.output


def test_flag_option_named_help(runner):
    """A flag named ``help`` must not trigger the help option."""

    @click.command()
    @click.option("--verbose", "help", is_flag=True)
    def cli(help):
        click.echo(f"help={help}")

    result = runner.invoke(cli, ["--verbose"])
    assert result.exit_code == 0, result.output
    assert result.output == "help=True\n"

    result = runner.invoke(cli, [])
    assert result.exit_code == 0, result.output
    assert result.output == "help=False\n"
```

