 'WITH a AS MATERIALIZED (SELECT 1) SELECT * FROM a;',
 'WITH a AS (WITH b AS (SELECT 1) SELECT * FROM b) SELECT * FROM a;',
 'WITH a AS (SELECT 1), b AS (SELECT 2), c AS (SELECT 3) SELECT * FROM a JOIN b ON a.x=b.x JOIN c ON b.y=c.y;',
 'WITH a AS (SELECT 1) INSERT INTO foo SELECT * FROM a;',
 'WITH a AS (SELECT 1) UPDATE foo SET x=1;',
 'WITH a AS (SELECT 1) DELETE FROM foo;',
 'INSERT INTO foo WITH a AS (SELECT 1) SELECT * FROM a;',
 'WITH a AS (SELECT 1), -- comment\n b AS (SELECT 2) SELECT * FROM a;',
 'WITH a AS /* c */ (SELECT 1) SELECT * FROM a;',
 'WITH a AS (SELECT 1) , b AS (SELECT 2) SELECT * FROM a;',
]
for t in templates:
    try:
        r1=sqlparse.format(t, reindent=True)
        r2=sqlparse.format(r1, reindent=True)
        ok = r1==r2
    except Exception as e:
        ok=False; r1=r2=repr(e)
    if not ok:
        print('FAIL:', repr(t))
        print(' r1:', repr(r1))
        print(' r2:', repr(r2))
        print()
print('done')
