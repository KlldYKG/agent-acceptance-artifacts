import json, urllib.request, tarfile, os, io, re
versions=['0.5.1','0.5.2','0.5.3','0.5.4','0.5.5','0.6.0','0.6.1']
for v in versions:
    try:
        d=json.load(urllib.request.urlopen(f'https://pypi.org/pypi/sqlparse/{v}/json', timeout=20))
        sdist=[u for u in d['urls'] if u['packagetype']=='sdist'][0]['url']
        data=urllib.request.urlopen(sdist, timeout=30).read()
        tf=tarfile.open(fileobj=io.BytesIO(data))
        names=tf.getnames()
        hits=[]
        for n in names:
            if n.endswith(('.py','CHANGELOG')):
                content=tf.extractfile(n).read().decode('utf-8','replace')
                for i,line in enumerate(content.splitlines(),1):
                    if re.search('idempot', line, re.I) or ('cte' in line.lower() and ('test' in n.lower() or 'CHANGELOG' in n)):
                        hits.append((n, i, line.strip()))
        print('VERSION', v, 'hits', len(hits))
        for h in hits[:15]: print('  ', h)
    except Exception as e:
        print('VERSION',v,'ERR',type(e).__name__,e)
