import sqlparse, itertools, random
random.seed(1)
base_templates = [
 'WITH a AS (SELECT 1) SELECT * FROM a;',
 'WITH a AS (SELECT 1), b AS (SELECT 2) SELECT * FROM a, b;',
 'WITH a AS (SELECT 1), b AS (SELECT * FROM a) SELECT * FROM b;',
 'WITH RECURSIVE a AS (SELECT 1 UNION ALL SELECT 2) SELECT * FROM a;',
 'WITH a (x) AS (SELECT 1) SELECT x FROM a;',
]
ws = [' ', '\n', '\n\n', '  ', '\t', ' \n ', '\r\n', '\n  ']
def mutate(q):
    # randomly replace existing spaces with whitespace variants
    out=[]
    for ch in q:
        if ch==' ' and random.random()<0.6:
            out.append(random.choice(ws))
        else:
            out.append(ch)
    s=''.join(out)
    # randomly insert comments at selected positions
    for marker in ['WITH','AS','SELECT','FROM',',','(']:
        if random.random()<0.3:
            idx=s.find(marker)
            if idx>=0:
                ins=random.choice(['-- c\n','/* c */ ','\n-- c\n'])
                s=s[:idx+len(marker)]+ins+s[idx+len(marker):]
    return s
opts_list=[dict(reindent=True), dict(reindent=True, strip_whitespace=False)]
fails=0
for i in range(3000):
    q=mutate(random.choice(base_templates))
    for opts in opts_list:
        try:
            r1=sqlparse.format(q, **opts); r2=sqlparse.format(r1, **opts)
        except Exception:
            continue
        if r1!=r2:
            fails+=1
            print('FAIL opts', opts)
            print(' IN', repr(q))
            print(' r1', repr(r1))
            print(' r2', repr(r2))
            print()
            if fails>=12:
                raise SystemExit
print('fails', fails)
