+END
+TRANSACTION;"""
+    stmts = sqlparse.split(sql)
+    assert len(stmts) == 4
+    assert stmts[0] == 'BEGIN\nTRANSACTION;'
+    assert stmts[1].startswith('DELETE')
+    assert stmts[2].startswith('INSERT')
