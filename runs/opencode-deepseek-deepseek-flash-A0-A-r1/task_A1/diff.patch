+def test_digest_auth_rfc_2069_response():
+    auth = httpx.DigestAuth(username="user", password="pass")
+    request = httpx.Request("GET", "https://www.example.com/")
+
+    flow = auth.sync_auth_flow(request)
+    request = next(flow)
+
+    # An RFC 2069 challenge is one that does not include a 'qop' field.
+    headers = {
+        "WWW-Authenticate": 'Digest realm="realm", nonce="nonce", opaque="opaque"'
+    }
+    response = httpx.Response(
+        content=b"Auth required", status_code=401, headers=headers, request=request
+    )
+    request = flow.send(response)
+
+    authorization = request.headers["Authorization"]
+    assert authorization.startswith("Digest ")
+    fields = parse_keqv_list(authorization[len("Digest ") :].split(", "))
+
+    # The 'qop', 'nc' and 'cnonce' fields are only used for RFC 2617 responses.
+    assert "qop" not in fields
+    assert "nc" not in fields
+    assert "cnonce" not in fields
+
+    # See https://www.rfc-editor.org/rfc/rfc2069#section-2.1.2
+    ha1 = hashlib.md5(b"user:realm:pass").hexdigest()
+    ha2 = hashlib.md5(b"GET:/").hexdigest()
+    expected_response = hashlib.md5(f"{ha1}:nonce:{ha2}".encode()).hexdigest()
+    assert fields["response"] == expected_response
+
