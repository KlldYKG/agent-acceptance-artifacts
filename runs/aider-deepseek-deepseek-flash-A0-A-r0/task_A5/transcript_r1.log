tests/test_urlparse_percent_encoding.py
```
import httpx


def test_lone_percent_in_path_is_escaped():
    url = httpx.URL("http://example.com/100%")
    assert url.path == "/100%"
    assert url.raw_path == b"/100%25"
    assert str(url) == "http://example.com/100%25"


def test_lone_percent_amongst_valid_escapes():
    url = httpx.URL("http://example.com/a%20b%zz")
    assert url.raw_path == b"/a%20b%25zz"


def test_valid_percent_escapes_are_preserved():
    url = httpx.URL("http://example.com/pa%20th")
    assert url.path == "/pa th"
    assert url.raw_path == b"/pa%20th"


def test_lone_percent_in_query_is_escaped():
    url = httpx.URL("http://example.com/?q=100%")
    assert url.raw_path == b"/?q=100%25"
    assert str(url) == "http://example.com/?q=100%25"


def test_lone_percent_in_fragment_is_escaped():
    url = httpx.URL("http://example.com/#100%")
    assert url.fragment == "100%"
    assert str(url) == "http://example.com/#100%25"


def test_queryparams_lone_percent_is_escaped():
    params = httpx.QueryParams({"q": "100%"})
    assert str(params) == "q=100%25"


def test_queryparams_valid_escape_is_preserved():
    params = httpx.QueryParams("q=100%25")
    assert params["q"] == "100%"
    assert str(params) == "q=100%25"
