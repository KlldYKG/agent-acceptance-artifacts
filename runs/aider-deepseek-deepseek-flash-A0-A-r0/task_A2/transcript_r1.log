def echo_timeout(request: httpx.Request) -> httpx.Response:
    return httpx.Response(200, json=request.extensions["timeout"])


def test_client_send_applies_timeout_to_new_request_instance():
    # A `Request` instance created directly by the user (rather than via
    # `client.build_request()`) should still have the client timeout applied.
    timeout = httpx.Timeout(5.0, connect=10.0)
    transport = httpx.MockTransport(echo_timeout)

    with httpx.Client(transport=transport, timeout=timeout) as client:
        request = httpx.Request("GET", "http://example.org")
        response = client.send(request)

    assert response.status_code == 200
    assert response.json() == timeout.as_dict()


def test_client_send_preserves_existing_request_timeout():
    # Any timeout explicitly set on the request takes precedence over
    # the client-level timeout.
    request_timeout = httpx.Timeout(1.0)
    transport = httpx.MockTransport(echo_timeout)

    with httpx.Client(transport=transport, timeout=httpx.Timeout(5.0)) as client:
        request = httpx.Request(
            "GET",
            "http://example.org",
            extensions={"timeout": request_timeout.as_dict()},
        )
        response = client.send(request)

    assert response.status_code == 200
    assert response.json() == request_timeout.as_dict()


@pytest.mark.asyncio
async def test_async_client_send_applies_timeout_to_new_request_instance():
    # The async client behaves the same way as the sync client here.
    timeout = httpx.Timeout(5.0, connect=10.0)
    transport = httpx.MockTransport(echo_timeout)

    async with httpx.AsyncClient(transport=transport, timeout=timeout) as client:
        request = httpx.Request("GET", "http://example.org")
        response = await client.send(request)

    assert response.status_code == 200
    assert response.json() == timeout.as_dict()
