Actually let me recall the `build_request` method:
```python
def build_request(
    self,
    method: str,
    url: URLTypes,
    *,
    content=None,
    data=None,
    files=None,
    json=None,
    params=None,
    headers=None,
    cookies=None,
    timeout: ... = USE_CLIENT_DEFAULT,
    extensions=None,
) -> Request:
    url = self._merge_url(url)
    headers = self._merge_headers(headers)
    cookies = self._merge_cookies(cookies)
    params = self._merge_queryparams(params)
    extensions = {} if extensions is None else dict(extensions)
    if "timeout" not in extensions:
        timeout = (
            self.timeout
            if isinstance(timeout, UseClientDefault)
            else Timeout(timeout)
        )
        extensions = dict(**extensions, timeout=timeout)
    return Request(
        method, url, content=content, data=data, files=files, json=json,
        params=params, headers=headers, cookies=cookies, extensions=extensions,
    )
```

