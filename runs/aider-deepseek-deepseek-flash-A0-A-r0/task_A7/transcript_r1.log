tests/test_urlparse_default_safe_characters.py
```
from httpx._urlparse import DEFAULT_SAFE_CHARACTERS, percent_encoded, quote


def test_default_safe_characters_include_sub_delims_and_pchar() -> None:
    for char in "!$&'()*+,;=:@/":
        assert char in DEFAULT_SAFE_CHARACTERS


def test_percent_encoded_uses_default_safe_characters() -> None:
    assert percent_encoded("!$&'()*+,;=:@/") == "!$&'()*+,;=:@/"


def test_percent_encoded_escapes_non_safe_characters() -> None:
    assert percent_encoded("a b") == "a%20b"
    assert percent_encoded("a#b") == "a%23b"
    assert percent_encoded("a?b") == "a%3Fb"


def test_percent_encoded_explicit_safe_overrides_default() -> None:
    assert percent_encoded("a/b", safe="") == "a%2Fb"


def test_quote_uses_default_safe_characters() -> None:
    assert quote("!$&'()*+,;=:@/") == "!$&'()*+,;=:@/"


def test_quote_escapes_non_safe_characters() -> None:
    assert quote("a b") == "a%20b"
    assert quote("a#b") == "a%23b"


def test_quote_preserves_existing_percent_escapes() -> None:
    assert quote("%20") == "%20"


def test_quote_explicit_safe_overrides_default() -> None:
    assert quote("a/b", safe="") == "a%2Fb"
