+def test_url_percent_escaping_sets():
+    # See https://url.spec.whatwg.org/#percent-encoded-bytes
+    url = httpx.URL("https://example.com/a b?c d#e f")
+    assert str(url) == "https://example.com/a%20b?c%20d#e%20f"
+
+    # Backticks are escaped in the path and fragment, but not in the query.
+    url = httpx.URL("https://example.com/a`b?c`d#e`f")
+    assert str(url) == "https://example.com/a%60b?c`d#e%60f"
+
+    # Curly braces are escaped in the path, but not in the query or fragment.
+    url = httpx.URL("https://example.com/a{b?c{d#e{f")
+    assert str(url) == "https://example.com/a%7Bb?c{d#e{f"
+
+
