+@pytest.mark.anyio
+async def test_digest_auth_no_specified_qop_uses_rfc2069_digest() -> None:
+    """
+    In RFC 2069 mode (i.e. no qop) the response digest is computed as
+    H(HA1:nonce:HA2), where HA1 is H(username:realm:password).
+    """
+    url = "https://example.org/"
+    auth = httpx.DigestAuth(username="user", password="password123")
+    app = DigestApp(qop="", regenerate_nonce=False)
+
+    async with httpx.AsyncClient(transport=httpx.MockTransport(app)) as client:
+        response = await client.get(url, auth=auth)
+
+    assert response.status_code == 200
+
+    authorization = typing.cast(typing.Dict[str, typing.Any], response.json())["auth"]
+    _, _, fields = authorization.partition(" ")
+    digest_data = dict(field.strip().split("=", 1) for field in fields.split(","))
+
+    nonce = digest_data["nonce"].strip('"')
+    expected_ha1 = hashlib.sha256(b"user:httpx@example.org:password123").hexdigest()
+    expected_ha2 = hashlib.sha256(b"GET:/").hexdigest()
+    expected_response = hashlib.sha256(
+        f"{expected_ha1}:{nonce}:{expected_ha2}".encode()
+    ).hexdigest()
+
+    assert digest_data["response"] == f'"{expected_response}"'
+
+
